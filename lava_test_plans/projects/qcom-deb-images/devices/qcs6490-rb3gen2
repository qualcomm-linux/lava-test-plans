{% extends "devices/qcs6490-rb3gen2" %}

{# Device-specific values exported to testcase templates #}
{% set TESTCASE_VARIABLES = {
    "FASTRPC_DOMAINS": ['adsp', 'cdsp']
} %}

{# the ufs flashing stage comes from the common device #}
{% set qdl_image_dir = "flash_qcs6490-rb3gen2-vision-kit_ufs" %}
{% set qdl_rootfs_image = "disk-ufs.img2" %}
{% set qdl_tarball = "flash-ufs.tar.gz" %}

{# ask for the vision kit, an alias of the qcs6490-rb3gen2 device type, #}
{# which also covers the core kit                                       #}
{% block device_type %}qcs6490-rb3gen2-vision-kit{% endblock %}

{# exclusions are tracked in                                     #}
{# https://github.com/qualcomm-linux/qcom-deb-images/issues/647 #}
{% import "projects/qcom-deb-images/include/excluded-tests.jinja2" as excluded %}
{# hotplug passes or fails by chance (qcom-deb-images #692) #}
{# BT_ON_OFF passes or fails by chance (qcom-deb-images #735) #}
{# DSP_AudioPD fails on any remoteproc error in dmesg, and the modem   #}
{# remoteproc fails to load qcom/qcs6490/modem.mbn (error -2) on some #}
{# boots only, with every kernel and on several boards               #}
{# fastrpc_test fails on any FastRPC error in dmesg, and the compute #}
{# context banks log mmap/unmmap errors on some boots only          #}
{# cdsp_remoteproc fails when the CDSP does not come up:               #}
{# qcom_q6v5_pas a300000.remoteproc: start timed out / can't start     #}
{# rproc cdsp: -110, on some boots only, on every rb3gen2 board and    #}
{# with every kernel                                                    #}
{% set EXCLUDED_TESTS = excluded.EXCLUDED_TESTS + ['hotplug', 'BT_ON_OFF', 'DSP_AudioPD', 'fastrpc_test', 'cdsp_remoteproc'] %}
{% set EXCLUDED_TESTPLANS = excluded.EXCLUDED_TESTPLANS %}
