{% extends device_type %}

{% set PROJECT_NAME = PROJECT_NAME|default("") %}
{% set BUILD_NUMBER = BUILD_NUMBER|default("") %}
{% set KERNEL_BRANCH = KERNEL_BRANCH|default("unknown") %}
{% set OS_INFO = OS_INFO|default("") %}
{% set EXTRA_KERNEL_ARGS = EXTRA_KERNEL_ARGS|default() %}
{% set EXCLUDED_TESTS = EXCLUDED_TESTS|default([]) %}

{# GitHub serves a source tarball per commit, so the definitions can share  #}
{# one cached fetch instead of a git clone each. The sha is resolved before  #}
{# rendering; without one, fall back to git.                                 #}
{% set testdef_repo = TEST_DEFINITIONS_REPOSITORY|default("")|trim|trim("/") %}
{% set testdef_repo = testdef_repo[:-4] if testdef_repo.endswith(".git") else testdef_repo %}
{% set testdef_sha = TEST_DEFINITIONS_REVISION_SHA|default("") %}

{# with the BUILD_NUMBER in the middle, it's possible to get #}
{# the sub job name(which is the test_name here) #}
{# from this lava job name information #}
{% block job_name %}{{PROJECT_NAME}}-{{OS_INFO}}-{{BUILD_NUMBER}}-{{test_name}}{% endblock job_name %}

{% block context %}
{{ super() }}
  {%- if EXTRA_KERNEL_ARGS is defined and EXTRA_KERNEL_ARGS %}
  extra_kernel_args: '{{EXTRA_KERNEL_ARGS}}'
  {%- endif %}
{% endblock context %}

{% block test_target %}
{% if all_tests is defined %}
  {# A test with variants is included when its base name is not excluded and #}
  {# at least one variant is defined. Non-variant tests retain old behavior. #}
  {% for test in all_tests %}
  {% if (test.name not in EXCLUDED_TESTS) and (test.include|default(true)) and
        (test.variants is not defined or test.variants) %}
  {{ super() }}
  {# include the super block once if any tests are included #}
  {% break %}
  {% endif %}
  {% endfor %}
{% if testdef_sha %}
    # {{ TEST_DEFINITIONS_REVISION|default("HEAD", true) }} resolved to {{ testdef_sha }}
{% endif %}
    {% for test in all_tests %}
    {# Check if the base test should be included. #}
    {% if (test.name not in EXCLUDED_TESTS) and (test.include|default(true)) and
          (test.variants is not defined or test.variants) %}
      {% if test.variants is defined %}
        {% for variant in test.variants %}
    {%- if testdef_sha %}
    - from: url
      name: "{{ variant.name|default(test.name + "_" + variant.suffix) }}"
      path: {{ test.path }}
      repository: {{ testdef_repo }}/archive/{{ testdef_sha }}.tar.gz
      strip-components: 1
    {%- else %}
    - from: git
      name: "{{ variant.name|default(test.name + "_" + variant.suffix) }}"
      path: {{ test.path }}
      repository: {{ TEST_DEFINITIONS_REPOSITORY }}
      {% if TEST_DEFINITIONS_REVISION is defined and TEST_DEFINITIONS_REVISION %}
      revision: {{ TEST_DEFINITIONS_REVISION }}
      {% endif %}
    {% endif %}
      {% if test.params is defined or variant.params is defined %}
      {% set base_params = test.params|default({}) %}
      {% set variant_params = variant.params|default({}) %}
      params:
        {% for param_key, param_value in base_params.items() %}
        {{ param_key }}: "{{ param_value }}"
        {% endfor %}
        {% for param_key, param_value in variant_params.items() %}
        {{ param_key }}: "{{ param_value }}"
        {% endfor %}
      {% endif %}
      {% if variant.expected is defined and variant.expected %}
      expected:
        {% for expected in variant.expected %}
        - {{ expected }}
        {% endfor %}
      {% elif test.expected is defined and test.expected %}
      expected:
        {% for expected in test.expected|default([]) %}
        - {{ expected }}
        {% endfor %}
      {% endif %}

        {% endfor %}
      {% else %}
    {%- if testdef_sha %}
    - from: url
      name: "{{ test.name }}"
      path: {{ test.path }}
      repository: {{ testdef_repo }}/archive/{{ testdef_sha }}.tar.gz
      strip-components: 1
    {%- else %}
    - from: git
      name: "{{ test.name }}"
      path: {{ test.path }}
      repository: {{ TEST_DEFINITIONS_REPOSITORY }}
      {% if TEST_DEFINITIONS_REVISION is defined and TEST_DEFINITIONS_REVISION %}
      revision: {{ TEST_DEFINITIONS_REVISION }}
      {% endif %}
    {% endif %}
      {% if test.params is defined %}
      params:
        {% for param_key, param_value in test.params.items() %}
        {{ param_key }}: "{{ param_value }}"
        {% endfor %}
      {% endif %}
      {% if test.expected is defined and test.expected %}
      expected:
        {% for expected in test.expected|default([]) %}
        - {{ expected }}
        {% endfor %}
      {% endif %}

      {% endif %}
    {% endif %}
    {% endfor %}
{% else %}
  {{ super() }}
{% endif %}
{% endblock test_target %}
